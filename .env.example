# ============================================================
# TRANSCENDENCE — go-live secrets template
# Copy to `.env` and fill in. NEVER commit `.env`. NEVER share keys.
# ============================================================

# ---- 1. DEPLOYER WALLET (the most important, most sensitive line) ----
# A FRESH wallet you control. For mainnet this must be a cold/hardware wallet.
# ⚠️ NEVER use a Hardhat default dev key for real money — they are public.
PRIVATE_KEY=

# ---- 2. RPC ENDPOINTS (free: Alchemy / Infura / public RPC) ----
SEPOLIA_RPC=https://rpc.sepolia.org
MAINNET_RPC=
BASE_RPC=
OPTIMISM_RPC=
ARBITRUM_RPC=

# ---- 3. BLOCK EXPLORER API KEYS (for contract verification) ----
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=

# ---- 4. THE MIND (AI keeper) — local dev only ----
# This key is a Hardhat dev default and is PUBLIC. Do not fund it with real assets.
MIND_PRIVATE_KEY=0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6
RPC_URL=http://127.0.0.1:8545
TREASURY_DELAY=60
TREASURY_FUND=10000
MIND_INTERVAL=30

# ---- 5. OPENAI (off-chain Mind decisions) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
